diff --git a/web/shim/cxx26_shim.h b/web/shim/cxx26_shim.h
new file mode 100644
index 0000000..aaee763
--- /dev/null
+++ b/web/shim/cxx26_shim.h
@@ -0,0 +1,27 @@
+#pragma once
+#if defined(__cplusplus) && __cplusplus > 202002L
+// Compile-only shim for libstdc++ 13 lacking C++26 std::function_ref (non-owning callable reference).
+#include <functional>
+#include <type_traits>
+#include <memory>
+#include <utility>
+#include <type_traits>
+namespace std {
+#ifndef __cpp_lib_to_underlying
+template<class E> constexpr underlying_type_t<E> to_underlying(E e) noexcept { return static_cast<underlying_type_t<E>>(e); }
+#endif
+template<class Sig> class function_ref;
+template<class R, class... Args> class function_ref<R(Args...)> {
+  void* obj_{nullptr}; R(*call_)(void*, Args...){nullptr};
+public:
+  template<class F> requires (!is_same_v<remove_cvref_t<F>, function_ref> && is_invocable_r_v<R, F&, Args...>)
+  function_ref(F&& f) noexcept : obj_(const_cast<void*>(static_cast<const void*>(addressof(f)))),
+    call_([](void* o, Args... a)->R{ return invoke_r<R>(*static_cast<remove_reference_t<F>*>(o), std::forward<Args>(a)...); }) {}
+  function_ref(R(*fp)(Args...)) noexcept : obj_(reinterpret_cast<void*>(fp)), call_([](void* o, Args... a)->R{ return reinterpret_cast<R(*)(Args...)>(o)(std::forward<Args>(a)...); }) {}
+  function_ref(const function_ref&) noexcept = default;
+  function_ref& operator=(const function_ref&) noexcept = default;
+  R operator()(Args... a) const { return call_(obj_, std::forward<Args>(a)...); }
+};
+}
+
+#endif
diff --git a/web/web_audio.cpp b/web/web_audio.cpp
new file mode 100644
index 0000000..59afdbb
--- /dev/null
+++ b/web/web_audio.cpp
@@ -0,0 +1,73 @@
+// Browser audio: the game's own audio::runtime renders float stereo blocks; this file feeds them to a Web Audio worklet.
+// Hardware that needs files or threads the browser build lacks (Roland ROM synths, Gravis GF1, CUE/BIN CD audio) is stubbed:
+// requesting it throws, exactly like a missing ROM does in the native build, and the game continues without it.
+#include <algorithm>
+#include <array>
+#include <stdexcept>
+#include <vector>
+#include "audio/cd_player.h"
+#include "audio/gus_samples.h"
+#include "audio/la_synth.h"
+#include "audio/sc55_synth.h"
+#include "platform/audio_output.h"
+#include "web_host.h"
+
+namespace tfx::platform {
+namespace {
+pcm_callback active_callback{nullptr};
+void *active_user{nullptr};
+}
+struct audio_output::implementation {};
+audio_output::audio_output(pcm_callback callback, void *userdata) : state{std::make_unique<implementation>()} { active_callback = callback; active_user = userdata; }
+audio_output::~audio_output() { active_callback = nullptr; active_user = nullptr; }
+
+/// Called from the browser host's frame and wait paths: renders whatever the page's audio queue is missing.
+void web_audio_pump() {
+  if(!active_callback) return;
+  static std::vector<float> block(1024 * 2);
+  int wanted{tfx_audio_wanted()};
+  for(int guard{0}; wanted > 0 && guard != 16; ++guard) {
+    int const frames{std::min(wanted,1024)};
+    std::span<float> const stereo{block.data(),static_cast<size_t>(frames) * 2};
+    std::fill(stereo.begin(),stereo.end(),0.0f);
+    active_callback(active_user,stereo);
+    tfx_audio_push(block.data(),frames);
+    wanted -= frames;
+  }
+}
+} // namespace tfx::platform
+
+namespace tfx::audio {
+struct cd_player::implementation {};
+cd_player::cd_player(std::filesystem::path const &, unsigned int) { throw std::runtime_error{"CD audio images are not available in the browser"}; }
+cd_player::~cd_player() = default;
+bool cd_player::contains(unsigned int) const { return false; }
+bool cd_player::play(unsigned int) { return false; }
+void cd_player::stop() {}
+bool cd_player::playing() const { return false; }
+void cd_player::render(std::span<float>) {}
+
+struct gus_samples::implementation {};
+gus_samples::gus_samples(std::span<gus_sample_data const>, gus_parameters const &, unsigned int) { throw std::runtime_error{"Gravis UltraSound is not available in the browser"}; }
+gus_samples::~gus_samples() = default;
+void gus_samples::enable(bool) {}
+void gus_samples::advance(simulation::timer_ticks) {}
+void gus_samples::submit(sample_priority, std::span<unsigned int const>) {}
+void gus_samples::render(std::span<float>) {}
+gus_playback_state gus_samples::value() { return {}; }
+
+struct la_synth::implementation {};
+la_synth::la_synth(std::filesystem::path const &, unsigned int) { throw std::runtime_error{"Roland LA ROMs are not available in the browser"}; }
+la_synth::~la_synth() = default;
+void la_synth::short_message(uint32_t) {}
+void la_synth::sysex(std::span<uint8_t const>) {}
+void la_synth::render(std::span<float>) {}
+void la_synth::silence() {}
+
+struct sc55_synth::implementation {};
+sc55_synth::sc55_synth(std::filesystem::path const &, unsigned int, sound_canvas_model) { throw std::runtime_error{"Sound Canvas ROMs are not available in the browser"}; }
+sc55_synth::~sc55_synth() = default;
+void sc55_synth::short_message(uint32_t) {}
+void sc55_synth::sysex(std::span<uint8_t const>) {}
+void sc55_synth::render(std::span<float>) {}
+} // namespace tfx::audio
