+  endif()
+  string(SUBSTRING "${core}" 0 ${position} core)
+  string(REPLACE "#include \"adlib.h\"" "" core "${core}")
+  if(extension STREQUAL "cpp")
+    string(PREPEND core "#include <cstddef>\n#include <type_traits>\n")
+    string(REPLACE "DBOPL::Chip* chip = 0;" "static_assert(std::is_standard_layout_v<DBOPL::Chip>);" core "${core}")
+    string(REPLACE "reinterpret_cast<Bitu>( &(chip->chan[ index ]) )" "offsetof(DBOPL::Chip, chan) + index * sizeof(DBOPL::Channel)" core "${core}")
+    string(REPLACE "DBOPL::Channel* chan = 0;" "static_assert(std::is_standard_layout_v<DBOPL::Channel>);" core "${core}")
+    string(REPLACE "reinterpret_cast<Bitu>( &(chan->op[opNum]) )" "offsetof(DBOPL::Channel, op) + opNum * sizeof(DBOPL::Operator)" core "${core}")
+  endif()
+  file(WRITE "${DBOPL_OUT}/dbopl.${extension}" "${core}${ending}")
+endforeach()
+add_executable(tfx_web ${CORE_SRCS} ${PLATFORM_SRCS} ../src/main.cpp web_glfw.cpp web_window.cpp web_audio.cpp ${AUDIO_SRCS} ${QSOUND_SRCS} "${DBOPL_OUT}/dbopl.cpp")
+set_source_files_properties("${DBOPL_OUT}/dbopl.cpp" PROPERTIES COMPILE_OPTIONS "-fwrapv")
+target_include_directories(tfx_web PRIVATE ../src .. include shim "${DBOPL_OUT}" "${CMAKE_CURRENT_LIST_DIR}/../src/platform/dbopl" "/home/claude/work/deps/qsound")
+target_compile_definitions(tfx_web PRIVATE VECTORSTORM_NO_BOOST)
+target_compile_options(tfx_web PRIVATE -fwasm-exceptions "SHELL:-mllvm -wasm-use-legacy-eh=false" -ffp-contract=off "SHELL:-include algorithm" "SHELL:-include ${CMAKE_CURRENT_LIST_DIR}/shim/cxx26_shim.h" -Wno-c++11-narrowing -Wno-deprecated-declarations)
