diff --git a/tests/presentation_layout_test.cpp b/tests/presentation_layout_test.cpp
new file mode 100644
index 0000000..28c24ae
--- /dev/null
+++ b/tests/presentation_layout_test.cpp
@@ -0,0 +1,52 @@
+#include <cmath>
+#include <cstdlib>
+#include <iostream>
+#include "platform/presentation_layout.h"
+
+using namespace tfx::platform;
+
+namespace {
+// The unmodified presentation code, kept verbatim as the reference the defaults must reproduce.
+display_area legacy_viewport(int const width, int const height) {
+  double const available{std::min(width / static_cast<double>(tfx::render::display_width),height / static_cast<double>(tfx::render::display_height))};
+  double const fit{available >= 1 ? std::floor(available) : available};
+  vec2<int> const fitted{std::max(1,static_cast<int>(tfx::render::display_width * fit)),std::max(1,static_cast<int>(tfx::render::display_height * fit))};
+  return {.position{(width - fitted.x) / 2,(height - fitted.y) / 2}, .size{vec2<int>{fitted}}};
+}
+int failures{0};
+void check(bool const ok, char const *const what, int const w = 0, int const h = 0) {
+  if(!ok) { ++failures; std::cerr << "FAIL: " << what << " (" << w << "x" << h << ")\n"; }
+}
+} // anonymous namespace
+
+int main() {
+  presentation_options const defaults;
+  check(defaults.fit == fit_mode::integer && !defaults.crt_aspect && !defaults.linear_filter && !defaults.fullscreen && defaults.vsync,"defaults are the unmodified presentation");
+  // 1. Defaults reproduce the unmodified placement for every size from tiny to 8K.
+  unsigned int compared{0};
+  for(int w{1}; w <= 8192; w += (w < 700 ? 1 : 37)) for(int h{1}; h <= 4320; h += (h < 500 ? 1 : 41)) {
+    auto const expected{legacy_viewport(w,h)}, actual{compute_display_area(w,h,defaults)};
+    check(expected.position.x == actual.position.x && expected.position.y == actual.position.y && expected.size.x == actual.size.x && expected.size.y == actual.size.y,"default layout differs from the original",w,h);
+    ++compared;
+  }
+  // 2. Other modes stay inside the window and keep their promised shape.
+  for(auto const &[w,h] : {std::pair{1920,1080},std::pair{2560,1440},std::pair{3840,2160},std::pair{1280,800},std::pair{1000,1000},std::pair{640,480},std::pair{300,150}}) {
+    presentation_options options;
+    options.fit = fit_mode::fit;
+    auto fit{compute_display_area(w,h,options)};
+    check(fit.position.x >= 0 && fit.position.y >= 0 && fit.position.x + fit.size.x <= w && fit.position.y + fit.size.y <= h,"fit stays inside the window",w,h);
+    check(std::abs(fit.size.x * 200.0 - fit.size.y * 320.0) <= 320.0 + 200.0,"fit keeps 320:200 shape",w,h);
+    options.crt_aspect = true;
+    auto crt{compute_display_area(w,h,options)};
+    check(crt.position.x >= 0 && crt.position.y >= 0 && crt.position.x + crt.size.x <= w && crt.position.y + crt.size.y <= h,"crt fit stays inside the window",w,h);
+    check(std::abs(crt.size.x / static_cast<double>(crt.size.y) - 4.0 / 3.0) < 0.02,"crt aspect is 4:3",w,h);
+    options.fit = fit_mode::stretch;
+    auto stretch{compute_display_area(w,h,options)};
+    check(stretch.position.x == 0 && stretch.position.y == 0 && stretch.size.x == w && stretch.size.y == h,"stretch fills the window",w,h);
+    options.crt_aspect = false; options.fit = fit_mode::integer;
+    auto whole{compute_display_area(w,h,options)};
+    check(whole.size.x % 320 == 0 && whole.size.y % 200 == 0 || w < 320 || h < 200,"integer mode uses whole-number scales",w,h);
+  }
+  if(failures) return EXIT_FAILURE;
+  std::cout << "Presentation layout: " << compared << " window sizes reproduce the original placement; fit, CRT-aspect, stretch and integer modes checked\n";
+}
diff --git a/tests/remaster_upscale_test.cpp b/tests/remaster_upscale_test.cpp
new file mode 100644
index 0000000..722973f
--- /dev/null
+++ b/tests/remaster_upscale_test.cpp
@@ -0,0 +1,63 @@
+#include <cstdlib>
+#include <iostream>
+#include <set>
+#include "render/remaster_upscale.h"
+
+using namespace tfx::render;
+namespace {
+int failures{0};
+void check(bool const ok, char const *const what) { if(!ok) { ++failures; std::cerr << "FAIL: " << what << "\n"; } }
+rgba_pixel colour(uint8_t const v) { return rgba_pixel{v,v,v,255}; }
+bool same(rgba_pixel const &a, rgba_pixel const &b) { return a.x == b.x && a.y == b.y && a.z == b.z; }
+} // anonymous namespace
+
+int main() {
+  // 1. A flat image stays flat and doubles in size.
+  std::vector<rgba_pixel> flat(4 * 3,colour(7));
+  auto const doubled{scale2x(flat,4,3)};
+  check(doubled.width == 8 && doubled.height == 6,"scale2x doubles the size");
+  for(auto const &pixel : doubled.pixels) check(same(pixel,colour(7)),"flat image stays flat");
+  // 2. A diagonal edge is smoothed: the corner pixel is cut, a straight edge is not.
+  //   . X .        The rule replaces the corner of the lone pixel only where two neighbours agree.
+  std::vector<rgba_pixel> diagonal{
+    colour(1),colour(1),colour(1),
+    colour(1),colour(2),colour(2),
+    colour(1),colour(2),colour(2)};
+  auto const smooth{scale2x(diagonal,3,3)};
+  check(same(smooth.pixels[2 * 6 + 2],colour(1)),"outer corner of a staircase is rounded off");
+  std::vector<rgba_pixel> straight{
+    colour(1),colour(2),colour(2),
+    colour(1),colour(2),colour(2),
+    colour(1),colour(2),colour(2)};
+  auto const kept{scale2x(straight,3,3)};
+  for(int y{0}; y != 6; ++y) for(int x{0}; x != 6; ++x) check(same(kept.pixels[static_cast<size_t>(y * 6 + x)],straight[static_cast<size_t>(y / 2 * 3 + x / 2)]),"a straight edge is left exactly as it was");
+  // 3. No colour is ever invented: each output pixel is a colour of its 3x3 source neighbourhood. Pseudo-random 3-colour image.
+  unsigned int state{12345};
+  std::vector<rgba_pixel> noise(40 * 30);
+  for(auto &pixel : noise) { state = state * 1664525u + 1013904223u; pixel = colour(static_cast<uint8_t>(10 + (state >> 24) % 3)); }
+  auto const out{scale2x(noise,40,30)};
+  for(int y{0}; y != 60; ++y) for(int x{0}; x != 80; ++x) {
+    bool found{false};
+    for(int dy{-1}; dy <= 1 && !found; ++dy) for(int dx{-1}; dx <= 1; ++dx) {
+      int const sx{std::clamp(x / 2 + dx,0,39)}, sy{std::clamp(y / 2 + dy,0,29)};
+      if(same(out.pixels[static_cast<size_t>(y * 80 + x)],noise[static_cast<size_t>(sy * 40 + sx)])) { found = true; break; }
+    }
+    check(found,"output colour comes from the source neighbourhood");
+  }
+  // 4. Deterministic, and the 320x200 remaster frame is 1280x800.
+  std::vector<rgba_pixel> frame(320 * 200);
+  for(size_t i{0}; i != frame.size(); ++i) frame[i] = colour(static_cast<uint8_t>((i / 7 + i / 320) % 5));
+  auto const a{remaster_frame(frame)}, b{remaster_frame(frame)};
+  check(a.width == 1280 && a.height == 800,"remaster frame is 1280x800");
+  bool identical{a.pixels.size() == b.pixels.size()};
+  for(size_t i{0}; identical && i != a.pixels.size(); ++i) identical = same(a.pixels[i],b.pixels[i]);
+  check(identical,"remaster output is deterministic");
+  // 5. The source frame is not modified.
+  auto const copy{frame};
+  (void)remaster_frame(frame);
+  bool untouched{true};
+  for(size_t i{0}; i != frame.size(); ++i) untouched = untouched && same(frame[i],copy[i]);
+  check(untouched,"the game frame is never modified");
+  if(failures) return EXIT_FAILURE;
+  std::cout << "Remaster upscale: flat, staircase, straight-edge, no-new-colour, determinism and source-immutability checks passed\n";
+}
