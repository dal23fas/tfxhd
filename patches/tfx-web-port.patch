+// A small GLFW-compatible layer over browser imports. Implements only the calls the game makes.
+#include <GLFW/glfw3.h>
+#include <cstdint>
+#include <cstring>
+#include "web_host.h"
+
+namespace {
+struct fake_window { GLFWkeyfun key_callback{nullptr}; GLFWwindowfocusfun focus_callback{nullptr}; void *user{nullptr}; int cursor{GLFW_CURSOR_NORMAL}; };
+fake_window the_window;
+GLFWerrorfun error_callback{nullptr};
+} // anonymous namespace
+
+extern "C" {
+int glfwInit(void) { return GLFW_TRUE; }
+void glfwTerminate(void) {}
+GLFWerrorfun glfwSetErrorCallback(GLFWerrorfun cb) { auto previous{error_callback}; error_callback = cb; return previous; }
+int glfwGetPlatform(void) { return GLFW_PLATFORM_NULL; }
+void glfwWindowHint(int, int) {}
+GLFWwindow *glfwCreateWindow(int, int, const char *, GLFWmonitor *, GLFWwindow *) { return reinterpret_cast<GLFWwindow*>(&the_window); }
+void glfwDestroyWindow(GLFWwindow *) {}
+void glfwMakeContextCurrent(GLFWwindow *) {}
+void glfwSwapInterval(int) {}
+void glfwSwapBuffers(GLFWwindow *) {}
+void glfwShowWindow(GLFWwindow *) {}
+void glfwRestoreWindow(GLFWwindow *) {}
+void glfwSetWindowSize(GLFWwindow *, int, int) {}
+void glfwSetWindowPos(GLFWwindow *, int, int) {}
+void glfwSetWindowTitle(GLFWwindow *, const char *title) { tfx_set_title(title); }
+void glfwGetWindowSize(GLFWwindow *, int *width, int *height) { int wh[2]; tfx_window_size(wh); if(width) *width = wh[0]; if(height) *height = wh[1]; }
+void glfwGetFramebufferSize(GLFWwindow *w, int *width, int *height) { glfwGetWindowSize(w,width,height); }
+void glfwGetWindowFrameSize(GLFWwindow *, int *l, int *t, int *r, int *b) { if(l) *l = 0; if(t) *t = 0; if(r) *r = 0; if(b) *b = 0; }
+int glfwGetWindowAttrib(GLFWwindow *, int attribute) {
+  if(attribute == GLFW_FOCUSED) return tfx_focused() ? GLFW_TRUE : GLFW_FALSE;
+  return 0;
+}
+GLFWmonitor *glfwGetPrimaryMonitor(void) { return nullptr; }
+void glfwGetMonitorWorkarea(GLFWmonitor *, int *x, int *y, int *w, int *h) { if(x) *x = 0; if(y) *y = 0; if(w) *w = 1280; if(h) *h = 800; }
+const GLFWvidmode *glfwGetVideoMode(GLFWmonitor *) { static GLFWvidmode mode{1280,800,8,8,8,60}; return &mode; }
+void glfwSetWindowMonitor(GLFWwindow *, GLFWmonitor *, int, int, int, int, int) {}
+int glfwWindowShouldClose(GLFWwindow *) { return tfx_should_close(); }
+void glfwSetWindowUserPointer(GLFWwindow *w, void *pointer) { reinterpret_cast<fake_window*>(w)->user = pointer; }
+void *glfwGetWindowUserPointer(GLFWwindow *w) { return reinterpret_cast<fake_window*>(w)->user; }
+GLFWkeyfun glfwSetKeyCallback(GLFWwindow *w, GLFWkeyfun cb) { auto *fw{reinterpret_cast<fake_window*>(w)}; auto previous{fw->key_callback}; fw->key_callback = cb; return previous; }
+GLFWwindowfocusfun glfwSetWindowFocusCallback(GLFWwindow *w, GLFWwindowfocusfun cb) { auto *fw{reinterpret_cast<fake_window*>(w)}; auto previous{fw->focus_callback}; fw->focus_callback = cb; return previous; }
+void glfwSetInputMode(GLFWwindow *w, int mode, int value) { if(mode == GLFW_CURSOR) { reinterpret_cast<fake_window*>(w)->cursor = value; tfx_cursor_mode(value); } }
+int glfwGetInputMode(GLFWwindow *w, int mode) { return mode == GLFW_CURSOR ? reinterpret_cast<fake_window*>(w)->cursor : 0; }
+int glfwRawMouseMotionSupported(void) { return GLFW_FALSE; }
+int glfwGetKey(GLFWwindow *, int key) { return tfx_key_state(key) ? GLFW_PRESS : GLFW_RELEASE; }
+int glfwGetMouseButton(GLFWwindow *, int button) { return tfx_mouse_button(button) ? GLFW_PRESS : GLFW_RELEASE; }
+void glfwGetCursorPos(GLFWwindow *, double *x, double *y) { double xy[2]; tfx_mouse_pos(xy); if(x) *x = xy[0]; if(y) *y = xy[1]; }
+double glfwGetTime(void) { static double const origin{tfx_now_ms()}; return (tfx_now_ms() - origin) / 1000.0; }
+void glfwPollEvents(void) {
+  int event[3];
+  while(tfx_next_event(event)) if(the_window.key_callback) the_window.key_callback(reinterpret_cast<GLFWwindow*>(&the_window),event[0],0,event[1],event[2]);
+}
+void glfwWaitEventsTimeout(double timeout) { tfx::platform::web_audio_pump(); tfx_sleep_ms(timeout * 1000.0); glfwPollEvents(); }
+int glfwJoystickPresent(int) { return GLFW_FALSE; }
+const float *glfwGetJoystickAxes(int, int *count) { if(count) *count = 0; return nullptr; }
+const unsigned char *glfwGetJoystickButtons(int, int *count) { if(count) *count = 0; return nullptr; }
+}
