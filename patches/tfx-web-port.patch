+
 void software_renderer::primitive(models::primitive const &source, std::span<models::model_vertex const> const camera_vertices, camera const &view, std::span<uint8_t const> const texture, colour_map const *const remap) {
   /// Clip a complete authored primitive before projection, including its attributes
   if(camera_vertices.empty()) return;
+  if(auto *const capture{scene_capture::active()}) {
+    capture->view = view;
+    captured_primitive entry{source.kind,remap ? (*remap)[static_cast<uint8_t>(source.colour)] : static_cast<uint8_t>(source.colour),source.mode,{},{},texture.size(),source.pixel_size,source.radius};
+    // Clip against the near plane only (the GPU clips the screen edges), then use the game's own projection
+    std::vector<models::model_vertex> kept;
+    if(source.kind == models::primitive_kind::point) {
+      auto const &v{camera_vertices.front()};
+      if(v.position.z > view.near_distance * v.projection_scale && v.position.z <= view.far_distance) kept.push_back(v);
+    } else {
+      auto previous{camera_vertices.back()};
+      auto previous_distance{previous.position.z - view.near_distance * previous.projection_scale};
+      for(auto const &current : camera_vertices) {
+        auto const current_distance{current.position.z - view.near_distance * current.projection_scale};
+        if((previous_distance >= 0) != (current_distance >= 0)) kept.push_back(interpolate(previous,current,previous_distance / (previous_distance - current_distance)));
+        if(current_distance >= 0) kept.push_back(current);
+        previous = current;
+        previous_distance = current_distance;
+      }
+    }
+    for(auto const &v : kept) entry.screen.push_back(view.project(v.position,v.projection_scale));
+    entry.vertices = std::move(kept);
+    if(!entry.vertices.empty()) capture->primitives.push_back(std::move(entry));
+  }
   uint8_t const source_index{static_cast<uint8_t>(source.colour)};
   uint8_t const ink_index{remap ? (*remap)[source_index] : source_index};
   if(paint_model_primitive(output,source,camera_vertices,view,texture,remap,procedural_seed)) return;
