diff --git a/src/platform/presentation_layout.h b/src/platform/presentation_layout.h
new file mode 100644
index 0000000..d967bfa
--- /dev/null
+++ b/src/platform/presentation_layout.h
@@ -0,0 +1,46 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include "render/framebuffer.h"
+#include "vectorstorm/vector/vector2.h"
+
+namespace tfx::platform {
+
+/// How the fixed 320x200 image is placed in the window. Presentation only: nothing here touches simulation state.
+enum class fit_mode {
+  integer, ///< Largest whole-number scale that fits (the original behaviour and the default)
+  fit,     ///< Largest scale that fits, fractional allowed
+  stretch, ///< Fill the whole window
+};
+
+/// Display options shared by every window. Defaults reproduce the unmodified presentation exactly.
+struct presentation_options {
+  fit_mode fit{fit_mode::integer};
+  bool crt_aspect{false};     ///< Show 320x200 at the 4:3 shape VGA monitors gave it (pixels 1.2 times taller)
+  bool linear_filter{false};  ///< Bilinear scaling instead of nearest-neighbour
+  bool remaster{false};       ///< Smooth polygon edges with the Scale2x rule before display (Classic is the default)
+  bool fullscreen{false};
+  bool vsync{true};
+};
+
+struct display_area {
+  vec2<int> position;
+  vec2<int> size;
+};
+
+/// Pure layout function used both to draw the frame and to map mouse positions back to image coordinates.
+inline display_area compute_display_area(int const width, int const height, presentation_options const &options) {
+  if(options.fit == fit_mode::stretch) return {.position{0,0}, .size{std::max(1,width),std::max(1,height)}};
+  double const image_width{static_cast<double>(render::display_width)};
+  double const image_height{render::display_height * (options.crt_aspect ? 1.2 : 1.0)};
+  double const available{std::min(width / image_width,height / image_height)};
+  double const scale{options.fit == fit_mode::integer && available >= 1 ? std::floor(available) : available};
+  vec2<int> const fitted{std::max(1,static_cast<int>(image_width * scale)),std::max(1,static_cast<int>(image_height * scale))};
+  return {
+    .position{(width - fitted.x) / 2,(height - fitted.y) / 2},
+    .size{fitted},
+  };
+}
+
+} // namespace tfx::platform
