diff --git a/src/render/remaster_upscale.cpp b/src/render/remaster_upscale.cpp
new file mode 100644
index 0000000..3668360
--- /dev/null
+++ b/src/render/remaster_upscale.cpp
@@ -0,0 +1,64 @@
+#include "remaster_upscale.h"
+#include <fstream>
+#include <stdexcept>
+
+namespace tfx::render {
+namespace {
+bool same(rgba_pixel const &a, rgba_pixel const &b) {
+  return a.x == b.x && a.y == b.y && a.z == b.z;
+}
+} // anonymous namespace
+
+rgba_image scale2x(std::span<rgba_pixel const> const source, int const width, int const height) {
+  if(width <= 0 || height <= 0 || source.size() != static_cast<size_t>(width) * static_cast<size_t>(height)) throw std::invalid_argument{"scale2x: image size does not match its pixels"};
+  rgba_image result{.width{width * 2}, .height{height * 2}, .pixels{}};
+  result.pixels.resize(static_cast<size_t>(result.width) * static_cast<size_t>(result.height));
+  auto const at{[&](int x, int y) -> rgba_pixel const& {
+    // Edge pixels repeat outward so borders behave like flat colour
+    x = x < 0 ? 0 : (x >= width ? width - 1 : x);
+    y = y < 0 ? 0 : (y >= height ? height - 1 : y);
+    return source[static_cast<size_t>(y) * static_cast<size_t>(width) + static_cast<size_t>(x)];
+  }};
+  for(int y{0}; y != height; ++y) for(int x{0}; x != width; ++x) {
+    auto const &b{at(x,y - 1)}, &d{at(x - 1,y)}, &e{at(x,y)}, &f{at(x + 1,y)}, &h{at(x,y + 1)};
+    rgba_pixel e0{e}, e1{e}, e2{e}, e3{e};
+    if(!same(b,h) && !same(d,f)) {
+      if(same(d,b)) e0 = d;
+      if(same(b,f)) e1 = f;
+      if(same(d,h)) e2 = d;
+      if(same(h,f)) e3 = f;
+    }
+    auto const out{static_cast<size_t>(y * 2) * static_cast<size_t>(result.width) + static_cast<size_t>(x * 2)};
+    result.pixels[out] = e0;
+    result.pixels[out + 1] = e1;
+    result.pixels[out + static_cast<size_t>(result.width)] = e2;
+    result.pixels[out + static_cast<size_t>(result.width) + 1] = e3;
+  }
+  return result;
+}
+
+rgba_image remaster_frame(std::span<rgba_pixel const> const game_frame) {
+  auto const first{scale2x(game_frame,screen_width,screen_height)};
+  return scale2x(first.pixels,first.width,first.height);
+}
+
+rgba_image nearest_enlarge(std::span<rgba_pixel const> const source, int const width, int const height, int const factor) {
+  if(factor <= 0 || width <= 0 || height <= 0 || source.size() != static_cast<size_t>(width) * static_cast<size_t>(height)) throw std::invalid_argument{"nearest_enlarge: bad size"};
+  rgba_image result{.width{width * factor}, .height{height * factor}, .pixels{}};
+  result.pixels.resize(static_cast<size_t>(result.width) * static_cast<size_t>(result.height));
+  for(int y{0}; y != result.height; ++y) for(int x{0}; x != result.width; ++x)
+    result.pixels[static_cast<size_t>(y) * static_cast<size_t>(result.width) + static_cast<size_t>(x)] = source[static_cast<size_t>(y / factor) * static_cast<size_t>(width) + static_cast<size_t>(x / factor)];
+  return result;
+}
+
+void write_ppm(std::filesystem::path const &path, rgba_image const &image) {
+  std::ofstream stream{path,std::ios::binary};
+  if(!stream) throw std::runtime_error{"cannot write " + path.string()};
+  stream << "P6\n" << image.width << ' ' << image.height << "\n255\n";
+  for(auto const &pixel : image.pixels) {
+    char const rgb[3]{static_cast<char>(pixel.x),static_cast<char>(pixel.y),static_cast<char>(pixel.z)};
+    stream.write(rgb,3);
+  }
+}
+
+} // namespace tfx::render
