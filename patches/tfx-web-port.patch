+#pragma once
+// Imports provided by the browser (or by the node test harness). Module name: "tfx".
+#define TFX_IMPORT(name) __attribute__((import_module("tfx"), import_name(#name)))
+extern "C" {
+TFX_IMPORT(now_ms) double tfx_now_ms(void);
+TFX_IMPORT(key_state) int tfx_key_state(int glfw_key);
+TFX_IMPORT(mouse_button) int tfx_mouse_button(int button);
+TFX_IMPORT(mouse_pos) void tfx_mouse_pos(double *xy);
+TFX_IMPORT(next_event) int tfx_next_event(int *key_action_mods);
+TFX_IMPORT(sleep_ms) void tfx_sleep_ms(double milliseconds);       // suspends (JSPI) until the time passes or an input event arrives
+TFX_IMPORT(present) void tfx_present(void const *rgba, int width, int height, int x, int y, int display_width, int display_height); // suspends until the next display frame
+TFX_IMPORT(window_size) void tfx_window_size(int *wh);
+TFX_IMPORT(cursor_mode) void tfx_cursor_mode(int mode);
+TFX_IMPORT(should_close) int tfx_should_close(void);
+TFX_IMPORT(set_title) void tfx_set_title(char const *utf8);
+TFX_IMPORT(focused) int tfx_focused(void);
+TFX_IMPORT(present_scene) void tfx_present_scene(float const *scene, int floats, unsigned char const *palette_rgb, unsigned char const *overlay_rgba, int x, int y, int display_width, int display_height); // suspends
+TFX_IMPORT(audio_wanted) int tfx_audio_wanted(void);   // frames of 48 kHz stereo the page can still accept
+TFX_IMPORT(audio_push) void tfx_audio_push(float const *interleaved_stereo, int frames);
+TFX_IMPORT(remaster_mode) int tfx_remaster_mode(void); // 0 = Classic, 1 = Remaster (Scale2x), 2 = HD (GPU scene); display only
+}
+
+namespace tfx::platform { void web_audio_pump(); }
diff --git a/web/web_window.cpp b/web/web_window.cpp
new file mode 100644
index 0000000..3acede9
--- /dev/null
+++ b/web/web_window.cpp
@@ -0,0 +1,90 @@
+// Browser version of platform::window: the same interface, drawing through the page's canvas instead of OpenGL.
+#include "platform/window.h"
+#include <algorithm>
+#include <vector>
+#include "render/software_renderer.h"
+#include "web_host.h"
+
+namespace tfx::platform {
+presentation_options &presentation_settings() {
+  static presentation_options options;
+  return options;
+}
+glfw_runtime::glfw_runtime() { glfwInit(); }
+glfw_runtime::~glfw_runtime() {}
+
+window::window(unsigned int const) : handle{nullptr, glfwDestroyWindow} {
+  handle.reset(glfwCreateWindow(render::display_width,render::display_height,"TFX",nullptr,nullptr));
+}
+window::~window() {}
+GLFWwindow *window::get() const { return handle.get(); }
+bool window::focused() const { return glfwGetWindowAttrib(handle.get(),GLFW_FOCUSED) == GLFW_TRUE; }
+bool window::poll() {
+  glfwPollEvents();
+  return !glfwWindowShouldClose(handle.get());
+}
+std::optional<vec2d> window::cursor_coordinates() const {
+  int width{0}, height{0};
+  glfwGetWindowSize(handle.get(),&width,&height);
+  if(width <= 0 || height <= 0) return {};
+  double x{0}, y{0};
+  glfwGetCursorPos(handle.get(),&x,&y);
+  auto const area{compute_display_area(width,height,presentation_settings())};
+  x -= area.position.x;
+  y -= area.position.y;
+  return vec2d{x * render::screen_width / area.size.x,y * render::screen_height / area.size.y};
+}
+std::optional<vec2<int16_t>> window::cursor_position() const {
+  auto const position{cursor_coordinates()};
+  if(!position || position->x < 0 || position->y < 0 || position->x >= render::screen_width || position->y >= render::screen_height) return {};
+  return vec2<int16_t>{*position};
+}
+void window::title(std::string const &text) { glfwSetWindowTitle(handle.get(),text.c_str()); }
+void window::present(std::span<render::rgba_pixel const> const pixels) {
+  web_audio_pump();
+  int width{0}, height{0};
+  glfwGetFramebufferSize(handle.get(),&width,&height);
+  if(width <= 0 || height <= 0) return;
+  int const mode{tfx_remaster_mode()};
+  render::scene_capture::requested() = mode == 2;
+  presentation_settings().fit = mode == 2 ? fit_mode::fit : fit_mode::integer; // HD uses the whole window; Classic keeps whole-pixel scaling
+  if(mode == 2) {
+    auto *const capture{render::scene_capture::latest()};
+    if(capture && capture->fresh && pixels.size() == static_cast<size_t>(render::screen_width) * render::screen_height) {
+      capture->fresh = false;
+      auto const area{compute_display_area(width,height,presentation_settings())};
+      static std::vector<float> stream;
+      static std::vector<unsigned char> palette, overlay;
+      stream.clear();
+      auto const &view{capture->view};
+      stream.insert(stream.end(),{static_cast<float>(view.focal_distance),static_cast<float>(view.projection_origin.x),static_cast<float>(view.projection_origin.y),static_cast<float>(view.near_distance),static_cast<float>(view.far_distance),static_cast<float>(view.position.x),static_cast<float>(view.position.y),static_cast<float>(view.position.z),static_cast<float>(view.right.x),static_cast<float>(view.right.y),static_cast<float>(view.right.z),static_cast<float>(view.down.x),static_cast<float>(view.down.y),static_cast<float>(view.down.z),static_cast<float>(view.forward.x),static_cast<float>(view.forward.y),static_cast<float>(view.forward.z),static_cast<float>(capture->horizon.size()),static_cast<float>(capture->primitives.size())});
+      for(auto const &surface : capture->horizon) {
+        if(surface.rectangle && surface.vertices.empty()) stream.insert(stream.end(),{static_cast<float>(surface.colour),4,0,0,static_cast<float>(render::screen_width),0,static_cast<float>(render::screen_width),static_cast<float>(render::screen_height),0,static_cast<float>(render::screen_height)});
+        else {
+          stream.push_back(surface.colour); stream.push_back(static_cast<float>(surface.vertices.size()));
+          for(auto const &v : surface.vertices) { stream.push_back(v.x); stream.push_back(v.y); }
+        }
+      }
+      for(auto const &p : capture->primitives) {
+        stream.insert(stream.end(),{static_cast<float>(p.kind),static_cast<float>(p.colour),static_cast<float>(p.pixel_size),static_cast<float>(p.radius),static_cast<float>(p.vertices.size())});
+        for(size_t i{0}; i != p.vertices.size(); ++i) { auto const &v{p.vertices[i]}; stream.insert(stream.end(),{static_cast<float>(v.position.x),static_cast<float>(v.position.y),static_cast<float>(v.position.z),static_cast<float>(p.screen[i].x),static_cast<float>(p.screen[i].y)}); }
+      }
+      palette.resize(768);
+      for(unsigned i{0}; i != 256; ++i) for(unsigned c{0}; c != 3; ++c) palette[i * 3 + c] = capture->colours[i][c];
+      overlay.resize(pixels.size() * 4);
+      auto const *source{reinterpret_cast<unsigned char const *>(pixels.data())};
+      for(size_t i{0}; i != pixels.size(); ++i) { overlay[i*4] = source[i*4]; overlay[i*4+1] = source[i*4+1]; overlay[i*4+2] = source[i*4+2]; overlay[i*4+3] = capture->mask[i] ? 255 : 0; }
+      tfx_present_scene(stream.data(),static_cast<int>(stream.size()),palette.data(),overlay.data(),area.position.x,area.position.y,area.size.x,area.size.y);
+      return;
+    }
+  }
+  presentation_settings().remaster = mode == 1; // display-only toggle, may change any frame
+  presentation_settings().linear_filter = presentation_settings().remaster;
+  auto const area{compute_display_area(width,height,presentation_settings())};
+  if(presentation_settings().remaster && pixels.size() == static_cast<size_t>(render::screen_width) * render::screen_height) {
+    auto const enlarged{render::remaster_frame(pixels)};
+    tfx_present(enlarged.pixels.data(),enlarged.width,enlarged.height,area.position.x,area.position.y,area.size.x,area.size.y);
+  } else tfx_present(pixels.data(),render::screen_width,render::screen_height,area.position.x,area.position.y,area.size.x,area.size.y);
+}
+
+} // namespace tfx::platform
