+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+#include <span>
+#include <vector>
+#include "render/framebuffer.h"
+
+namespace tfx::render {
+
+/// A finished image of any size, in display colours. Presentation only: it is built from, and never feeds back into, the 320x200 game frame.
+struct rgba_image {
+  int width{0}, height{0};
+  std::vector<rgba_pixel> pixels;
+};
+
+/// Edge-preserving 2x enlargement (the AdvMAME2x / "Scale2x" rule). Flat-shaded polygon edges become smoother diagonals;
+/// every output colour is one already present in the 3x3 neighbourhood of its source pixel, so no new colours are invented.
+rgba_image scale2x(std::span<rgba_pixel const> source, int width, int height);
+
+/// Remaster enlargement of a 320x200 game frame: Scale2x applied twice (1280x800).
+rgba_image remaster_frame(std::span<rgba_pixel const> game_frame);
+
+/// Plain nearest-neighbour enlargement by a whole factor, for side-by-side comparison with the remaster.
+rgba_image nearest_enlarge(std::span<rgba_pixel const> source, int width, int height, int factor);
+
+void write_ppm(std::filesystem::path const &path, rgba_image const &image);
+
+} // namespace tfx::render
